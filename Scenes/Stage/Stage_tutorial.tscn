[node name="TutorialTrigger" parent="Entities" instance=ExtResource("11_o1nv7")]
position = Vector2(72, 1059)
tutorial_text = "Welcome to the game. 
Press the 'Z' key to jump.
You can adjust your jump height depending on how long you hold the button."

[node name="TutorialTrigger2" parent="Entities" instance=ExtResource("11_o1nv7")]
position = Vector2(689, 901)
tutorial_text = "Look, there's an enemy over there! Let's attack and take them down by pressing the 'X' key."

[node name="TutorialTrigger3" parent="Entities" instance=ExtResource("11_o1nv7")]
position = Vector2(1320, 1018)
tutorial_text = "Hold [Shift] to block projectiles and reduce incoming damage. If you guard with perfect timing, the damage will be negated and your next attack will be empowered."

[node name="TutorialTrigger4" parent="Entities" instance=ExtResource("11_o1nv7")]
position = Vector2(1961, 1042)
tutorial_text = "Bullets of specific colors can be parried by pressing [X] with perfect timing. A parried bullet will always hit the opponent, dealing heavy counter damage."

[node name="TutorialTrigger5" parent="Entities" instance=ExtResource("11_o1nv7")]
position = Vector2(2600, 1045)
tutorial_text = "Defeating enemies will cause them to drop Gold, which can be used in shops or during specific events. Saving it up will surely bring you good fortune. Or, you might just find it scattered across the field."

[node name="TutorialTrigger6" parent="Entities" instance=ExtResource("11_o1nv7")]
position = Vector2(3873, 1045)
tutorial_text = "Press [I] to see your inventory and your status.
Well then, let's dive into the real adventure! Enjoy your journey."

